# Groq API key (free) — used server-side as a fallback if a user doesn't
# supply their own key in the browser. Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Flask session secret — required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# and keep it stable across restarts, or every restart logs everyone out.
FLASK_SECRET=change-this-to-a-long-random-string

# Database connection string. Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///app.db

# PayFast (billing). Get sandbox credentials at https://sandbox.payfast.co.za/
# — never use sandbox and live credentials interchangeably. Leave
# PAYFAST_SANDBOX=true until you're genuinely ready to take real payments.
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
# Optional — only set if your PayFast account has a passphrase configured
# (Settings > Integration in the PayFast dashboard). Leave blank otherwise;
# appending an empty passphrase to every signature is a real bug, not a
# no-op, if your account doesn't have one set.
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# ZAR, major units (e.g. "99.00"), not cents.
PAYFAST_PRO_PRICE_ZAR=99.00

# Resend (email verification on signup). Create a key at resend.com ->
# API Keys. A signup still succeeds even if sending fails (see auth.py),
# so this being unset just means the user has to use "Resend email" once
# it's configured, not that signup breaks.
RESEND_API_KEY=re_your-key-here
# Must be on a domain verified in the Resend dashboard (Domains tab).
# Resend's shared onboarding@resend.dev address works without any domain
# verification, but only delivers to the Resend account's own verified
# email -- fine for local dev, not for real users.
EMAIL_FROM=ORBITAL Careers <onboarding@resend.dev>
